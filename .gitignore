# Android signing secrets - NEVER commit these
**/key.properties
**/*.jks
**/*.keystore
**/upload-keystore.jks

# Store screenshots are generated (see docs/SCREENSHOTS.md). Only the English
# phone set and the feature graphic are kept in git, for the documentation.
/docs/screenshots/*
!/docs/screenshots/en/
/docs/screenshots/en/*/
!/docs/screenshots/en/play-phone/
